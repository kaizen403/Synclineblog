---
import Header from "../components/Header.astro";
import BlurCircle from "@/components/shared/BlurCircle.astro";
import theme from "@/data/theme";
import SEOTags from "@/components/seo/SEOTags.astro";

import "@fontsource/open-sans";
import "@/styles/tailwind.css";
import "@/styles/post.css";



export interface Props {
  title?: string;
  description?: string;
  og?: {
    title?: string;
    type?: string;
    description?: string;
    image?: string;
    alt?: string;
  };
  article?: {
    publishedTime?: string;
  };
}

const { title, description, og, article } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <SEOTags title={title} description={description} og={og} article={article} />
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Lexend&family=Ubuntu+Mono:wght@700&display=swap');
    </style> 
    
  <body
    class=" effect mx-auto flex  max-w-[872px] flex-col gap-9 px-10 py-8 text-sm text-neutral-400 md:gap-20 md:py-16"
  >
  
  
    <Header />
    
    <slot />
    
  </body>
</html>
